    "MART_DB.SALES.T_DAILY_SALES": {
      "type": "task",
      "columns": [],
      "body": "INSERT INTO MART_DB.SALES.DAILY_SALES (SALES_DATE, PREFECTURE, CHANNEL, ORDER_COUNT, TOTAL_AMOUNT)\nSELECT\n    o.ORDER_DATE,\n    c.PREFECTURE,\n    o.CHANNEL,\n    COUNT(DISTINCT o.ORDER_ID) AS ORDER_COUNT,\n    SUM(o.ORDER_AMOUNT) AS TOTAL_AMOUNT\nFROM DWH_DB.CORE.FCT_ORDERS o\nJOIN DWH_DB.CORE.DIM_CUSTOMER c USING (CUSTOMER_ID)\nWHERE o.ORDER_DATE = CURRENT_DATE - 1\nGROUP BY 1, 2, 3;"
    },
