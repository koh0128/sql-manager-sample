      "type": "procedure",
      "columns": [],
      "body": "BEGIN\n    CREATE OR REPLACE TABLE DWH_DB.CORE.FCT_ORDER_ITEMS AS\n    SELECT i.ORDER_ID, i.LINE_NO, i.PRODUCT_ID, i.QTY,\n           i.QTY * i.UNIT_PRICE AS LINE_AMOUNT\n    FROM RAW_DB.EC.ORDER_ITEMS_RAW i\n    JOIN DWH_DB.CORE.DIM_PRODUCT p USING (PRODUCT_ID);\n    RETURN 'ok';\nEND;"
