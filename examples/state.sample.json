    "DWH_DB.CORE.T_LOAD_ORDERS": {
      "type": "task",
      "columns": [],
      "body": "MERGE INTO DWH_DB.CORE.FCT_ORDERS t\nUSING RAW_DB.EC.ORDERS_RAW_STREAM s\n    ON t.ORDER_ID = s.ORDER_ID\nWHEN MATCHED THEN UPDATE SET ORDER_STATUS = UPPER(s.STATUS)\nWHEN NOT MATCHED THEN INSERT (ORDER_ID, CUSTOMER_ID, ORDER_DATE, ORDER_AMOUNT, ORDER_STATUS, CHANNEL)\n    VALUES (s.ORDER_ID, s.CUSTOMER_ID, TO_DATE(s.ORDER_TS), s.TOTAL, UPPER(s.STATUS), s.CHANNEL);"
    },
    "MART_DB.MARKETING.V_CHANNEL_CONVERSION": {
      "type": "view",
      "columns": [
        [
          "VIEW_DATE",
          "VARCHAR",
          "日付"
        ],
        [
          "SOURCE_CHANNEL",
          "VARCHAR",
          "流入チャネル"
        ],
        [
          "SESSIONS",
          "VARCHAR",
          "セッション数"
        ],
        [
          "ORDERS",
          "VARCHAR",
          "注文数"
        ],
        [
          "CVR",
          "VARCHAR",
          "ORDERS / SESSIONS"
        ]
      ],
      "ddl": "CREATE OR REPLACE VIEW MART_DB.MARKETING.V_CHANNEL_CONVERSION AS\nSELECT\n    pv.VIEW_DATE,\n    pv.SOURCE_CHANNEL,\n    COUNT(DISTINCT pv.SESSION_ID) AS SESSIONS,\n    COUNT(DISTINCT o.ORDER_ID)    AS ORDERS,\n    COUNT(DISTINCT o.ORDER_ID) / NULLIF(COUNT(DISTINCT pv.SESSION_ID), 0) AS CVR\nFROM DWH_DB.CORE.FCT_PAGE_VIEWS pv\nLEFT JOIN DWH_DB.CORE.FCT_ORDERS o\n    ON o.CUSTOMER_ID = pv.CUSTOMER_ID\n   AND o.ORDER_DATE = pv.VIEW_DATE\nGROUP BY 1, 2;\n",
      "last_read": "2026-10-18T06:15+09:00",
      "reads_30d": 3105
    },
